{#- ---------------------------------------------------------------- #}
{#- Bias gauge: headline totals, the half doughnut and a legend table. #}
{#- Renders one <tr> of the 640px container table.                    #}
{#- ---------------------------------------------------------------- #}
{%- set gauge = section.images.gauge %}
<tr>
<td class="mobile-padding" style="padding: 28px 24px 0 24px;">

{#- Section heading #}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
<tr>
<td class="section-heading" style="padding: 0 0 8px 0; border-bottom: 1px solid #dddddd;">{{ section.variables.heading }}</td>
</tr>
</table>

{#- The three headline totals, left to right #}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
<tr>
{%- for headline in section.variables.headlines %}
<td width="33%" align="{{ headline.align }}" valign="top" style="padding: 16px 0 0 0; font-family: Arial, Helvetica, sans-serif;">
<span style="font-size: 11px; line-height: 15px; font-weight: bold; letter-spacing: 1px; text-transform: uppercase; color: {{ headline.colour }};">{{ headline.label }}</span><br />
<span style="font-size: 20px; line-height: 26px; font-weight: bold; color: {{ headline.colour }};">{{ headline.amount | money }}</span>
</td>
{%- endfor %}
</tr>
</table>

{#- The half doughnut #}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
<tr>
<td align="center" style="padding: 8px 0 0 0;">
<img src="{{ gauge.src }}" width="{{ gauge.width }}" height="{{ gauge.height }}" alt="{{ gauge.alt }}" style="display: block; border: 0; width: 100%; max-width: {{ gauge.width }}px; height: auto;" />
</td>
</tr>
</table>

{#- Legend: one row per bias, left to right #}
<table role="presentation" align="center" cellpadding="0" cellspacing="0" border="0">
{%- for row in section.variables.legend %}
<tr>
<td width="11" style="padding: 4px 8px 4px 0;">
<table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr><td width="11" height="11" bgcolor="{{ row.colour }}" style="width: 11px; height: 11px; background-color: {{ row.colour }}; font-size: 0; line-height: 0;">&nbsp;</td></tr></table>
</td>
<td style="padding: 4px 16px 4px 0; font-family: Arial, Helvetica, sans-serif; font-size: 12px; line-height: 16px; color: #1a1a1a;">{{ row.name }}</td>
<td align="right" style="padding: 4px 12px 4px 0; font-family: Arial, Helvetica, sans-serif; font-size: 12px; line-height: 16px; font-weight: bold; color: #1a1a1a;">{{ row.amount | money }}</td>
<td align="right" style="padding: 4px 0; font-family: Arial, Helvetica, sans-serif; font-size: 12px; line-height: 16px; color: #666666;">{{ row.share | percent }}</td>
</tr>
{%- endfor %}
</table>

{#- Window and notes #}
<p class="note-text" style="margin: 0; padding-top: 12px;">{{ section.variables.window_sentence }}.</p>
{%- for note in section.notes %}
<p class="note-text" style="margin: 0; padding-top: 4px;">{{ note }}</p>
{%- endfor %}

</td>
</tr>
