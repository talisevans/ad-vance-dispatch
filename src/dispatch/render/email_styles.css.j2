{#- The CSS every Dispatch shares: the email skeleton and the sample frame both include it. #}
  body { margin: 0; padding: 0; width: 100%; background-color: #f4f2ee; }
  table { border-collapse: collapse; }
  img { border: 0; outline: none; text-decoration: none; display: block; height: auto; }
  a { color: #002147; }
  .body-text { font-family: Arial, Helvetica, sans-serif; font-size: 14px; line-height: 20px; color: #1a1a1a; }
  .note-text { font-family: Arial, Helvetica, sans-serif; font-size: 12px; line-height: 18px; color: #666666; }
  .section-heading { font-family: Arial, Helvetica, sans-serif; font-size: 14px; line-height: 18px; font-weight: bold; letter-spacing: 2px; text-transform: uppercase; color: #002147; }
  @media screen and (max-width: 640px) {
    .container { width: 100% !important; }
    .stack-column { display: block !important; width: 100% !important; max-width: 100% !important; }
    .stack-image { width: 100% !important; max-width: 290px !important; }
    .mobile-padding { padding-left: 16px !important; padding-right: 16px !important; }
  }
