<!DOCTYPE html>
{#- ---------------------------------------------------------------- #}
{#- The frame one section's sample sits in: the shared CSS and the    #}
{#- 640px container table the section partial renders rows of. The    #}
{#- made-up data notice is added after rendering (render/samples.py).  #}
{#- ---------------------------------------------------------------- #}
<html lang="en">
<head>
<meta charset="utf-8" />
<title>{{ sample.title }}</title>
<style type="text/css">
{% include "email_styles.css.j2" %}
</style>
</head>
<body style="margin: 0; padding: 0; background-color: #f4f2ee;">
<table role="presentation" class="container" width="640" cellpadding="0" cellspacing="0" border="0" bgcolor="#ffffff" style="max-width: 640px; background-color: #ffffff; margin: 16px auto;">

{#- The sections, each rendering its own rows #}
{%- for section in sections %}
{% include section.partial %}
{%- endfor %}

</table>
</body>
</html>
